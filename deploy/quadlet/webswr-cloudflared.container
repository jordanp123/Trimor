# Cloudflare tunnel sidecar. Joins BOTH networks: backend (to reach nginx) and
# egress (to reach the Cloudflare edge). nginx itself never touches egress.
# EDIT: ContainerName / User / Group to match config.webswr (STACK_NAME, TUNNEL_UID).
[Unit]
Description=Cloudflare tunnel for WebSWR
After=network-online.target webswr.service
Wants=network-online.target

[Container]
ContainerName=cloudflared-tunnel-WebSWR
Image=docker.io/cloudflare/cloudflared:latest
Exec=tunnel run
# The tunnel token comes from a podman secret, NOT from a file in the deploy
# directory -- so it is never in the webroot, the build context, a backup of
# either, or this unit. Podman injects it as TUNNEL_TOKEN at container start,
# which is the variable cloudflared already reads. Create it once with:
#   printf '%s' 'YOUR-TOKEN' | podman secret create webswr-tunnel-token -
# (printf, not echo -- a trailing newline would corrupt the token.)
Secret=webswr-tunnel-token,type=env,target=TUNNEL_TOKEN
Network=webswr-backend.network
Network=webswr-egress.network
# Keeps the tunnel image patched: `systemctl --user enable --now
# podman-auto-update.timer` pulls newer digests and restarts on its own.
AutoUpdate=registry

# --- hardening (1:1 with the compose service) ---
User=17000
Group=17000
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
PodmanArgs=--memory=256m --pids-limit=4096 --cpu-shares=768

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
