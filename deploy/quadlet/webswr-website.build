# Builds the site image from the assembled WEBROOT, so a cold
# `systemctl --user start webswr-website.service` works without a manual build.
# The daily webswr-update.sh rebuilds this same tag with --pull (base-image
# freshness), so day to day this unit is only the cold-start path.
#
# NOTE the build context is the webroot -- the assembled site -- NOT the git
# checkout, which lives inside it. deploy/install.sh rewrites %h/webswr to your
# actual webroot and BuildArg SUBPATH from config.webswr, so nothing here needs
# hand-editing if you install with that script.
[Unit]
Description=Build the WebSWR site image

[Build]
ImageTag=localhost/webswr-website:latest
File=%h/webswr/Dockerfile
SetWorkingDirectory=%h/webswr
BuildArg=SUBPATH=webswr
